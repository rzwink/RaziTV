#!/usr/bin/env bash
set -e
set -x

source /common.sh

apt-get update
apt-get install -y iw hostapd dnsmasq lighttpd

# Enable CGI support if using lighttpd for POST (optional)
lighty-enable-mod cgi

# No need to chmod files in /var/www/html here —
# Just ensure they are marked executable in filesystem/
systemctl enable wifi-check.service
