#!/usr/bin/env bash
set -e
set -x

source /common.sh

# Install packages
apt-get update
apt-get install -y iw hostapd dnsmasq lighttpd chromium-browser

# Enable CGI (optional if serving shell scripts with lighttpd)
lighty-enable-mod cgi || true

# Unpack filesystem (this populates /etc/systemd/system/, /var/www/html/, etc.)
unpack /filesystem/etc /etc
unpack /filesystem/usr /usr
unpack /filesystem/var /var

# Now that files exist, we can modify them
chmod +x /var/www/html/wifi-submit.sh
chmod +x /usr/local/bin/start_hotspot_if_needed.sh

systemctl enable hostapd
systemctl enable dnsmasq
systemctl enable lighttpd

systemctl enable wifi-check.service
