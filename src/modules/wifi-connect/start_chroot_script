#!/bin/bash
set -ex
source /common.sh
install_cleanup_trap

# Install dependencies
apt-get update
apt-get install -y network-manager

# Download and install WiFi Connect v4.11.83 (aarch64)
mkdir -p /usr/local/sbin
curl -L "https://github.com/balena-os/wifi-connect/releases/download/v4.11.83/wifi-connect-aarch64-unknown-linux-gnu.tar.gz" | \
  tar -xz -C /usr/local/sbin
chmod +x /usr/local/sbin/wifi-connect

# Create systemd service
cat > /etc/systemd/system/wifi-connect.service <<EOF
[Unit]
Description=WiFi Connect
After=network-online.target
Requires=network-online.target

[Service]
ExecStart=/usr/local/sbin/wifi-connect
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

# Enable the service on boot
systemctl_if_exists enable wifi-connect.service
